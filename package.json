{
  "name": "@polza-ai/ai-cli",
  "version": "0.2.0",
  "description": "CLI for generating text, images and video via Polza AI API",
  "license": "MIT",
  "homepage": "https://github.com/polza-ai/ai-cli#readme",
  "bugs": {
    "url": "https://github.com/polza-ai/ai-cli/issues"
  },
  "repository": {
    "type": "git",
